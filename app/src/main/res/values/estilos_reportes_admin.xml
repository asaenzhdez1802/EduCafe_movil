<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="EduCafe.FiltroReporte"
        parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/admin_periodo_texto</item>
        <item name="backgroundTint">@color/admin_periodo_fondo</item>
        <item name="strokeColor">@color/cafe_borde_suave</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="EduCafe.NavReporte"
        parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/cafe_marron</item>
        <item name="iconTint">@color/cafe_marron</item>
        <item name="iconGravity">textTop</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">4dp</item>
    </style>

</resources>