<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F1">

    <!-- Contenido principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mi panel"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#633C2D" />

            <!-- Cerrar sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesionCompartida"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#633C2D"
                app:backgroundTint="#F5E5D8"
                app:cornerRadius="12dp" />

            <!-- Nombre del cliente -->
            <TextView
                android:id="@+id/txtNombrePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Nombre del cliente"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#633C2D" />

            <!-- Usuario -->
            <TextView
                android:id="@+id/txtUsuarioPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Cliente"
                android:textSize="14sp"
                android:textColor="#97877B" />

            <!-- Puntos -->
            <TextView
                android:id="@+id/txtPuntosPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/fondo_campo_login"
                android:backgroundTint="#E5EEDC"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="0 puntos"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#588B3B" />

            <!-- Tarjeta de progreso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/fondo_campo_login"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtSiguienteRecompensa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consultando siguiente recompensa..."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#633C2D" />

                <ProgressBar
                    android:id="@+id/progresoRecompensa"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#E65A00"
                    android:progressBackgroundTint="#F0E3D7" />

                <TextView
                    android:id="@+id/txtDetallePuntos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cargando puntos..."
                    android:textSize="13sp"
                    android:textColor="#97877B" />

            </LinearLayout>

            <!-- Hacer pedido -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/btnHacerPedido"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/fondo_campo_login"
                    android:gravity="center_vertical"
                    android:paddingStart="62dp"
                    android:paddingEnd="48dp"
                    android:text="Hacer pedido"
                    android:textColor="#433126"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="18dp"
                    app:srcCompat="@drawable/ic_pedidos"
                    app:tint="#E65A00"
                    android:contentDescription="@null" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="18dp"
                    app:srcCompat="@drawable/ic_flecha_derecha"
                    app:tint="#633C2D"
                    android:contentDescription="@null" />

            </FrameLayout>

            <!-- Mis recompensas -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/btnMisRecompensas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/fondo_campo_login"
                    android:gravity="center_vertical"
                    android:paddingStart="62dp"
                    android:paddingEnd="48dp"
                    android:text="Mis recompensas"
                    android:textColor="#433126"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="18dp"
                    app:srcCompat="@drawable/ic_regalo"
                    app:tint="#E65A00"
                    android:contentDescription="@null" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="18dp"
                    app:srcCompat="@drawable/ic_flecha_derecha"
                    app:tint="#633C2D"
                    android:contentDescription="@null" />

            </FrameLayout>

            <!-- Mis pedidos -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/btnMisPedidos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/fondo_campo_login"
                    android:gravity="center_vertical"
                    android:paddingStart="62dp"
                    android:paddingEnd="48dp"
                    android:text="Mis pedidos"
                    android:textColor="#433126"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="18dp"
                    app:srcCompat="@drawable/ic_documento"
                    app:tint="#E65A00"
                    android:contentDescription="@null" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="18dp"
                    app:srcCompat="@drawable/ic_flecha_derecha"
                    app:tint="#633C2D"
                    android:contentDescription="@null" />

            </FrameLayout>

            <!-- Información -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/btnInformacion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/fondo_campo_login"
                    android:gravity="center_vertical"
                    android:paddingStart="62dp"
                    android:paddingEnd="48dp"
                    android:text="Información"
                    android:textColor="#433126"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="18dp"
                    app:srcCompat="@drawable/ic_info"
                    app:tint="#E65A00"
                    android:contentDescription="@null" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="18dp"
                    app:srcCompat="@drawable/ic_flecha_derecha"
                    app:tint="#633C2D"
                    android:contentDescription="@null" />

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Barra inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <!-- Inicio -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navInicio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="12dp"
                android:text="Inicio"
                android:textColor="#633C2D"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/ic_inicio_nav"
                app:tint="#633C2D"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- Menú -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="12dp"
                android:text="Menú"
                android:textColor="#633C2D"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/ic_menu"
                app:tint="#633C2D"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- Pedidos -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navPedidos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="12dp"
                android:text="Pedidos"
                android:textColor="#633C2D"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/ic_pedidos"
                app:tint="#633C2D"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- Mi panel seleccionado -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navMiPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="12dp"
                android:text="Mi panel"
                android:textStyle="bold"
                android:textColor="#E65A00"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/ic_panel_seleccionado"
                app:tint="#E65A00"
                android:contentDescription="@null" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
