<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ENCABEZADO -->
            <Button
                android:id="@+id/btnVolverDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volver"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#746255"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalle del pedido"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#503627"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"/>

            <!-- INFORMACION GENERAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/txtFolioDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Folio: --"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#503627"/>

                <TextView
                    android:id="@+id/txtCodigoRecogidaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Código de recogida: --"
                    android:textSize="16sp"
                    android:textColor="#B94D2D"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/txtClienteDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cliente: --"
                    android:textSize="15sp"
                    android:textColor="#503627"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/txtFechaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha: --"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/txtEstadoDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado: --"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#B94D2D"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/txtEstadoPagoDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado del pago: --"
                    android:textSize="15sp"
                    android:textColor="#503627"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- PRODUCTOS DEL PEDIDO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Productos del pedido"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#503627"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/contenedorProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/txtSinProductos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consultando productos..."
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:gravity="center"
                    android:padding="12dp"/>

            </LinearLayout>

            <!-- NOTAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notas del pedido"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#503627"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtNotasDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin observaciones"
                android:textSize="14sp"
                android:textColor="#746255"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="14dp"/>

            <!-- TOTAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total del pedido"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#503627"/>

                <TextView
                    android:id="@+id/txtTotalDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ --"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#B94D2D"/>

            </LinearLayout>

            <!-- MENSAJES DEL SERVIDOR -->
            <TextView
                android:id="@+id/txtMensajeDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esperando información del pedido..."
                android:textSize="13sp"
                android:textColor="#777777"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- ACCIONES DEL CAJERO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnMarcarListo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Marcar listo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#746255"
            android:enabled="false"/>

        <Button
            android:id="@+id/btnEntregarPedido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Entregar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B94D2D"
            android:enabled="false"/>

    </LinearLayout>

</LinearLayout>