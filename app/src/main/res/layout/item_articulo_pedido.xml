<?xml version="1.0" encoding="utf-8"?>
<!-- Artículo del pedido (Figma 72:591) con Selector de cantidad (72:586) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imgArticulo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_crema_12"
        android:contentDescription="@string/foto_producto"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNombreArticulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/cafe_marron"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Café helado" />

        <TextView
            android:id="@+id/txtPrecioArticulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/cafe_texto_secundario"
            android:textSize="14sp"
            tools:text="$45.00 MXN" />
    </LinearLayout>

    <!-- Selector de cantidad -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pildora"
        android:backgroundTint="@color/cafe_crema_oscuro"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/btnMenos"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circulo_borde"
            android:contentDescription="@string/disminuir_cantidad"
            android:padding="7dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_quitar"
            app:tint="@color/ic_cafe" />

        <TextView
            android:id="@+id/txtCantidad"
            android:layout_width="20dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/cafe_marron"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="1" />

        <ImageButton
            android:id="@+id/btnMas"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circulo"
            android:backgroundTint="@color/cafe_naranja"
            android:contentDescription="@string/aumentar_cantidad"
            android:padding="7dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_agregar"
            app:tint="@color/cafe_blanco" />
    </LinearLayout>

</LinearLayout>
