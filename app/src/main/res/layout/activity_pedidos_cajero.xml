<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cafe_crema">

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- TITULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Pedidos de la app"
                android:textColor="@color/cafe_marron"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- FILTROS PRIMERA FILA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <!-- TODOS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="7dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Todos"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/cafe_blanco"
                    android:backgroundTint="@color/cafe_naranja"
                    app:cornerRadius="24dp" />

                <!-- PENDIENTES -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPendientes"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="7dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Pendientes"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/cafe_marron"
                    android:backgroundTint="@color/cafe_blanco"
                    app:cornerRadius="24dp"
                    app:strokeColor="#E5DED4"
                    app:strokeWidth="1dp" />

                <!-- LISTOS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListos"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="Listos"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/cafe_marron"
                    android:backgroundTint="@color/cafe_blanco"
                    app:cornerRadius="24dp"
                    app:strokeColor="#E5DED4"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- FILTROS SEGUNDA FILA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEntregados"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Entregados"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/cafe_marron"
                    android:backgroundTint="@color/cafe_blanco"
                    app:cornerRadius="24dp"
                    app:strokeColor="#E5DED4"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- CONTADORES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- PENDIENTES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tarjeta"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/txtPendientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="@color/cafe_naranja"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:text="Pendientes"
                        android:textColor="@color/cafe_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- LISTOS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tarjeta"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/txtListos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="#648E4B"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:text="Listos"
                        android:textColor="@color/cafe_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ENTREGADOS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tarjeta"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/txtEntregados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="@color/cafe_marron"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:text="Entregados"
                        android:textColor="@color/cafe_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- TARJETA DE PEDIDOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_tarjeta"
                android:elevation="2dp">

                <!-- ENCABEZADO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pedidos de hoy · app"
                    android:textColor="@color/cafe_marron"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="Toca un pedido para verlo o marcarlo como listo"
                    android:textColor="@color/cafe_texto_secundario"
                    android:textSize="12sp" />

                <!-- LISTADO REAL DE PEDIDOS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPedidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BARRA INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_barra_inferior"
        android:elevation="8dp">

        <!-- K1 RESUMEN -->
        <TextView
            android:id="@+id/navResumenCajero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_resumen"
            android:drawableTint="@color/cafe_marron"
            android:drawablePadding="6dp"
            android:text="Resumen"
            android:textColor="@color/cafe_marron"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- K2 PEDIDOS: ACTIVO -->
        <TextView
            android:id="@+id/navPedidosCajero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_lista"
            android:drawableTint="@color/cafe_naranja"
            android:drawablePadding="6dp"
            android:text="Pedidos"
            android:textColor="@color/cafe_naranja"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- K4 MIS VENTAS -->
        <TextView
            android:id="@+id/navMisVentasCajero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_documento"
            android:drawablePadding="6dp"
            android:drawableTint="@color/cafe_marron"
            android:focusable="true"
            android:gravity="center"
            android:text="Mis ventas"
            android:textColor="@color/cafe_marron"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>