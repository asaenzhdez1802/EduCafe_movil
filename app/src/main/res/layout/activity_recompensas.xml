<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F1">

    <!-- Contenido desplazable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Encabezado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <TextView
                        android:id="@+id/btnRegresarRecompensas"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_circulo_borde"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Regresar" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_atras"
                        app:tint="#633C2D"
                        android:contentDescription="@null" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Mis recompensas"
                    android:textColor="#4E2F1F"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Tarjeta de puntos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fondo_campo_login"
                android:padding="18dp"
                android:layout_marginBottom="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mis puntos"
                    android:textColor="#8C786B"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtPuntosRecompensas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Cargando puntos..."
                    android:textColor="#4E2F1F"
                    android:textStyle="bold"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/txtProximaRecompensa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Consultando siguiente recompensa..."
                    android:textColor="#433126"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/progresoPuntosRecompensas"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#6B9B4A"
                    android:progressBackgroundTint="#F1E5D9" />

                <TextView
                    android:id="@+id/txtReglaPuntos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Consultando regla de puntos..."
                    android:textColor="#8C786B"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Título de la sección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Recompensas para canjear en caja"
                android:textColor="#4E2F1F"
                android:textStyle="bold"
                android:textSize="18sp" />

            <!-- Estado de carga o error -->
            <TextView
                android:id="@+id/txtEstadoRecompensas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Cargando recompensas..."
                android:textColor="#8C786B"
                android:textSize="14sp" />

            <!-- Tarjetas agregadas desde Kotlin -->
            <LinearLayout
                android:id="@+id/contenedorRecompensas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- Navegación inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <!-- Inicio -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navInicioRecompensas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="12dp"
                android:text="Inicio"
                android:textColor="#633C2D"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ir a inicio" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/ic_inicio_nav"
                app:tint="#633C2D"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- Menú -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navMenuRecompensas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="12dp"
                android:text="Menú"
                android:textColor="#633C2D"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ir al menú" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/ic_menu"
                app:tint="#633C2D"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- Pedidos -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navPedidosRecompensas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="12dp"
                android:text="Pedidos"
                android:textColor="#633C2D"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ir a pedidos" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/ic_pedidos"
                app:tint="#633C2D"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- Mi panel seleccionado -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navMiPanelRecompensas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="12dp"
                android:text="Mi panel"
                android:textColor="#E65A00"
                android:textStyle="bold"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ir a mi panel" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/ic_panel_seleccionado"
                app:tint="#E65A00"
                android:contentDescription="@null" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
