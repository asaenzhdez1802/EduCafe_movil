<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F1">

    <!-- Contenido desplazable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Encabezado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/btnRegresarRecompensas"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="←"
                    android:textSize="26sp"
                    android:textColor="#6F4A35"
                    android:background="@drawable/fondo_campo_login"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Regresar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Mis recompensas"
                    android:textColor="#4E2F1F"
                    android:textSize="23sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Tarjeta de puntos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fondo_campo_login"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mis puntos"
                    android:textColor="#8C786B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtPuntosRecompensas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Cargando puntos..."
                    android:textColor="#4E2F1F"
                    android:textStyle="bold"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/txtProximaRecompensa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Consultando siguiente recompensa..."
                    android:textColor="#433126"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/progresoPuntosRecompensas"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="9dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#6B9B4A"
                    android:progressBackgroundTint="#F1E5D9" />

                <TextView
                    android:id="@+id/txtReglaPuntos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Consultando regla de puntos..."
                    android:textColor="#8C786B"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Título de la sección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Recompensas para canjear en caja"
                android:textColor="#4E2F1F"
                android:textStyle="bold"
                android:textSize="17sp" />

            <!-- Estado de carga o error -->
            <TextView
                android:id="@+id/txtEstadoRecompensas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Cargando recompensas..."
                android:textColor="#8C786B"
                android:textSize="14sp" />

            <!-- Las tarjetas se agregarán desde Kotlin -->
            <LinearLayout
                android:id="@+id/contenedorRecompensas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- Navegación inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="6dp">

        <!-- Inicio -->
        <TextView
            android:id="@+id/navInicioRecompensas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Inicio"
            android:textColor="#6F4A35"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ir a inicio" />

        <!-- Menú -->
        <TextView
            android:id="@+id/navMenuRecompensas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="⌕&#10;Menú"
            android:textColor="#6F4A35"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ir al menú" />

        <!-- Pedidos -->
        <TextView
            android:id="@+id/navPedidosRecompensas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♧&#10;Pedidos"
            android:textColor="#6F4A35"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ir a pedidos" />

        <!-- Mi panel -->
        <TextView
            android:id="@+id/navMiPanelRecompensas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="●&#10;Mi panel"
            android:textColor="#E65A00"
            android:textStyle="bold"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ir a mi panel" />

    </LinearLayout>

</LinearLayout>
