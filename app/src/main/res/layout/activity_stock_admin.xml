<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cafe_crema">

    <!-- CONTENIDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- ENCABEZADO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Stock"
                android:textColor="@color/cafe_marron"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:text="Consulta las existencias y las alertas del inventario."
                android:textColor="@color/cafe_texto_secundario"
                android:textSize="13sp" />

            <!-- RESUMEN DE ALERTAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_tarjeta"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alertas de inventario"
                    android:textColor="@color/cafe_marron"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Productos con existencias bajas o agotadas"
                    android:textColor="@color/cafe_texto_secundario"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtTotalAlertasStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="--"
                    android:textColor="@color/cafe_naranja"
                    android:textSize="35sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Productos en alerta"
                    android:textColor="@color/cafe_texto_secundario"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- BOTONES DE ACCION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- ACTUALIZAR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizarStock"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Actualizar stock"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/cafe_blanco"
                    android:backgroundTint="@color/cafe_naranja"
                    app:cornerRadius="14dp" />

                <!-- REGRESAR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegresarStock"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Volver"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/cafe_marron"
                    android:backgroundTint="@color/cafe_blanco"
                    app:cornerRadius="14dp"
                    app:strokeColor="#E6DED3"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- LISTADO DE INVENTARIO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Productos con alerta"
                android:textColor="@color/cafe_marron"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Existencias, unidades reservadas y disponibles"
                android:textColor="@color/cafe_texto_secundario"
                android:textSize="12sp" />

            <!-- ESTADO DE LA CONSULTA -->
            <TextView
                android:id="@+id/txtEstadoStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="Consultando inventario..."
                android:textColor="@color/cafe_texto_secundario"
                android:textSize="13sp" />

            <!-- TARJETAS CREADAS POR KOTLIN -->
            <LinearLayout
                android:id="@+id/contenedorProductosStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- BARRA INFERIOR DEL ADMINISTRADOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_barra_inferior"
        android:elevation="8dp">

        <!-- A1 VENTAS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navStockVentas"
            style="@style/EduCafe.NavReporte"
            android:text="Ventas"
            android:textColor="@color/cafe_marron"
            app:icon="@drawable/ic_ventas"
            app:iconGravity="textTop"
            app:iconSize="24dp"
            app:iconTint="@color/cafe_marron" />

        <!-- A2 PEDIDOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navStockPedidos"
            style="@style/EduCafe.NavReporte"
            android:text="Pedidos"
            android:textColor="@color/cafe_marron"
            app:icon="@drawable/ic_documento"
            app:iconGravity="textTop"
            app:iconSize="24dp"
            app:iconTint="@color/cafe_marron" />

        <!-- A3 PRODUCTOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navStockProductos"
            style="@style/EduCafe.NavReporte"
            android:text="Productos"
            android:textColor="@color/cafe_marron"
            app:icon="@drawable/ic_productos"
            app:iconGravity="textTop"
            app:iconSize="24dp"
            app:iconTint="@color/cafe_marron" />

        <!-- A4 STOCK: SELECCIONADO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navStockActual"
            style="@style/EduCafe.NavReporte"
            android:text="Stock"
            android:textColor="@color/cafe_naranja"
            app:icon="@drawable/ic_stock"
            app:iconGravity="textTop"
            app:iconSize="24dp"
            app:iconTint="@color/cafe_naranja" />

    </LinearLayout>

</LinearLayout>