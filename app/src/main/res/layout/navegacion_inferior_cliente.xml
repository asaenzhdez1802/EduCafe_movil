<?xml version="1.0" encoding="utf-8"?>
<!-- Navegación inferior del cliente (Figma: componente "Navegación inferior").
     COMPARTIDO: si Manuel ya creó esta barra, usa la suya con <include> y borra este archivo.
     La pestaña activa se pinta desde NavegacionCliente.configurarBarra(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navegacionInferior"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_barra_inferior"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/tabInicio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgTabInicio"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_inicio" />

        <TextView
            android:id="@+id/txtTabInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Inicio"
            android:textColor="@color/cafe_texto_gris"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgTabMenu"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_menu" />

        <TextView
            android:id="@+id/txtTabMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Menú"
            android:textColor="@color/cafe_texto_gris"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabPedidos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgTabPedidos"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_pedidos" />

        <TextView
            android:id="@+id/txtTabPedidos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pedidos"
            android:textColor="@color/cafe_texto_gris"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabMiPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgTabMiPanel"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_panel" />

        <TextView
            android:id="@+id/txtTabMiPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mi panel"
            android:textColor="@color/cafe_texto_gris"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
