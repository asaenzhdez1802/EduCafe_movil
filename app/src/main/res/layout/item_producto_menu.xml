<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/cafe_blanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgProductoMenu"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/txtNombreProductoMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cafe_marron" />

        <TextView
            android:id="@+id/txtEstadoProductoMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:text="@string/menu_agotado"
            android:textColor="@color/cafe_texto_secundario"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtPrecioProductoMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/cafe_texto_gris" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarProductoMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="12dp"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                app:icon="@drawable/ic_agregar"
                app:iconSize="20dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:iconTint="@color/cafe_blanco"
                app:backgroundTint="@color/cafe_naranja"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>