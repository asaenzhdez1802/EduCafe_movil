<?xml version="1.0" encoding="utf-8"?>
<!-- C3 · Confirmar pedido (Figma 90:605) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_crema"
    android:orientation="vertical">

    <!-- Encabezado con botón atrás -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <FrameLayout
            android:id="@+id/btnAtras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circulo_borde"
            android:clickable="true"
            android:contentDescription="@string/atras"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_atras"
                app:tint="@color/ic_cafe" />
        </FrameLayout>

        <TextView
            style="@style/EduCafe.TituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Confirmar pedido" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Resumen del pago -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total a pagar al recoger"
                    android:textColor="@color/cafe_texto_secundario"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtTotalConfirmar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/cafe_marron"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="$115.00 MXN" />

                <TextView
                    android:id="@+id/txtDetalleConfirmar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/cafe_texto_secundario"
                    android:textSize="13sp"
                    android:text="Retiro en cafetería · sin costo de servicio" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Método de pago"
                android:textColor="@color/cafe_marron"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Opción · Efectivo (única opción: el cobro se hace en caja) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_opcion_seleccionada"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/cafe_crema_oscuro">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_efectivo"
                        app:tint="@color/ic_cafe" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Efectivo en la cafetería"
                        android:textColor="@color/cafe_marron"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Pagas en efectivo en la caja al recoger tu pedido. Al pagarlo, la compra se suma a tu cuenta y ganas puntos."
                        android:textColor="@color/cafe_texto_secundario"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Radio seleccionado -->
                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_radio">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/cafe_naranja" />
                </FrameLayout>
            </LinearLayout>

            <!-- Aviso · Importante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_aviso_naranja"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/cafe_naranja">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_alerta"
                        app:tint="@color/cafe_blanco" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Importante"
                        android:textColor="@color/cafe_marron"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Al confirmarlo apartamos tus productos por 60 minutos. Paga en caja con tu código de recogida antes de que se cumpla ese tiempo o el pedido se cancelará."
                        android:textColor="@color/cafe_marron"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Acciones de pago -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pie_acciones"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnConfirmar"
            style="@style/EduCafe.BotonPrimario"
            android:layout_width="match_parent"
            android:text="Confirmar pedido" />

        <Button
            android:id="@+id/btnVolver"
            style="@style/EduCafe.BotonSecundario"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="Volver al pedido" />
    </LinearLayout>

</LinearLayout>
