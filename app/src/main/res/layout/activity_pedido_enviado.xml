<?xml version="1.0" encoding="utf-8"?>
<!-- C4 · Pedido enviado (Figma 3:299). Datos reales de registrar_pedido.php -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_crema"
    android:orientation="vertical">

    <TextView
        style="@style/EduCafe.TituloPantalla"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Pedido enviado" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Confirmación: círculo verde con palomita -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/cafe_verde">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_check"
                    app:tint="@color/cafe_blanco" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="¡Pedido enviado!"
                android:textColor="@color/cafe_verde"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Aviso · Pagar en caja -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_aviso_naranja"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_alerta"
                    app:tint="@color/ic_naranja" />

                <TextView
                    android:id="@+id/txtAvisoPago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/cafe_marron"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Apartamos tus productos por 60 minutos. Págalo en efectivo en caja antes de las 11:31 a. m. o se cancelará." />
            </LinearLayout>

            <!-- Código de recogida -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tarjeta_codigo"
                android:elevation="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Código de recogida"
                    android:textColor="@color/cafe_texto_secundario"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtCodigo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0.14"
                    android:textColor="@color/cafe_marron"
                    android:textIsSelectable="true"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    tools:text="A7K-93F" />
            </LinearLayout>

            <!-- Datos del pedido -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_etiqueta_verde"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_ticket"
                    app:tint="@color/ic_verde" />

                <TextView
                    android:id="@+id/txtFolio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/cafe_texto_gris"
                    android:textSize="16sp"
                    tools:text="Pedido: PED-0042" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_etiqueta_verde"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_reloj"
                    app:tint="@color/ic_verde" />

                <TextView
                    android:id="@+id/txtEstadoPedido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/cafe_texto_gris"
                    android:textSize="16sp"
                    tools:text="Estado: Pendiente · Por cobrar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_etiqueta_verde"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_ticket"
                    app:tint="@color/ic_verde" />

                <TextView
                    android:id="@+id/txtTotalPagar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/cafe_texto_gris"
                    android:textSize="16sp"
                    tools:text="Total a pagar en cafetería: $115.00 MXN" />
            </LinearLayout>

            <Button
                android:id="@+id/btnListo"
                style="@style/EduCafe.BotonPrimario"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="Listo" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/navegacion_inferior_cliente" />

</LinearLayout>
