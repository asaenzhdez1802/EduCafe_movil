<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cafe_crema">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/logo_educafe"
                android:scaleType="fitCenter"
                android:contentDescription="@string/menu_logo" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/foto_bienvenida"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/menu_foto" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/menu_bienvenido"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/cafe_marron" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_bienvenida_texto"
                android:textSize="18sp"
                android:textColor="@color/cafe_texto_gris" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIniciarSesion"
        style="@style/EduCafe.BotonPrimario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="12dp"
        android:text="Iniciar sesión" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerMenu"
        style="@style/EduCafe.BotonPrimario"
        android:layout_width="match_parent"
        android:layout_margin="18dp"
        android:text="@string/menu_ver_menu"
        app:icon="@drawable/ic_flecha_derecha"
        app:iconGravity="textEnd"
        app:iconTint="@color/cafe_blanco" />

</LinearLayout>