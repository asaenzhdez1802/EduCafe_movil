<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizPedidosAdmin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cafe_crema">

    <!-- CONTENIDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- TITULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Pedidos"
                android:textColor="@color/cafe_marron"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- FILTROS: PRIMERA FILA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- TODOS: SELECCIONADO -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Todos"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/cafe_blanco"
                    android:backgroundTint="@color/cafe_naranja"
                    app:cornerRadius="22dp" />

                <!-- PENDIENTES -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPendientes"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Pendientes"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/cafe_marron"
                    android:backgroundTint="@color/cafe_blanco"
                    app:cornerRadius="22dp"
                    app:strokeColor="#E6DED3"
                    app:strokeWidth="1dp" />

                <!-- LISTOS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListos"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Listos"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/cafe_marron"
                    android:backgroundTint="@color/cafe_blanco"
                    app:cornerRadius="22dp"
                    app:strokeColor="#E6DED3"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- FILTROS: SEGUNDA FILA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <!-- ENTREGADOS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEntregados"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Entregados"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/cafe_marron"
                    android:backgroundTint="@color/cafe_blanco"
                    app:cornerRadius="22dp"
                    app:strokeColor="#E6DED3"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- CONTADORES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <!-- TARJETA PENDIENTES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tarjeta"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/txtPendientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="@color/cafe_naranja"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Pendientes"
                        android:textColor="@color/cafe_texto_secundario"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- TARJETA LISTOS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tarjeta"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/txtListos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="#648E4B"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Listos"
                        android:textColor="@color/cafe_texto_secundario"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- TARJETA ENTREGADOS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tarjeta"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/txtEntregados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="@color/cafe_marron"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Entregados"
                        android:textColor="@color/cafe_texto_secundario"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- TARJETA DE PEDIDOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_tarjeta"
                android:elevation="2dp">

                <!-- ENCABEZADO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pedidos de la app · hoy"
                    android:textColor="@color/cafe_marron"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- DESCRIPCION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="Seguimiento en tiempo real; los atiende el cajero"
                    android:textColor="@color/cafe_texto_secundario"
                    android:textSize="12sp" />

                <!-- MENSAJE DE CARGA Y RESULTADOS -->
                <TextView
                    android:id="@+id/txtEstadoPedidosAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="Consultando pedidos..."
                    android:textColor="@color/cafe_texto_secundario"
                    android:textSize="12sp" />

                <!-- LISTA DE PEDIDOS REALES -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPedidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:clipToPadding="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BARRA INFERIOR DEL ADMINISTRADOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_barra_inferior"
        android:elevation="8dp">

        <!-- A1 VENTAS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navPedidosAdminVentas"
            style="@style/EduCafe.NavReporte"
            android:text="Ventas"
            android:textColor="@color/cafe_marron"
            app:icon="@drawable/ic_ventas"
            app:iconGravity="textTop"
            app:iconSize="24dp"
            app:iconTint="@color/cafe_marron" />

        <!-- A2 PEDIDOS SELECCIONADO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navPedidosAdminActual"
            style="@style/EduCafe.NavReporte"
            android:text="Pedidos"
            android:textColor="@color/cafe_naranja"
            app:icon="@drawable/ic_documento"
            app:iconGravity="textTop"
            app:iconSize="24dp"
            app:iconTint="@color/cafe_naranja" />

        <!-- A3 PRODUCTOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navPedidosAdminProductos"
            style="@style/EduCafe.NavReporte"
            android:text="Productos"
            android:textColor="@color/cafe_marron"
            app:icon="@drawable/ic_productos"
            app:iconGravity="textTop"
            app:iconSize="24dp"
            app:iconTint="@color/cafe_marron" />

        <!-- A4 STOCK -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navPedidosAdminStock"
            style="@style/EduCafe.NavReporte"
            android:text="Stock"
            android:textColor="@color/cafe_marron"
            app:icon="@drawable/ic_stock"
            app:iconGravity="textTop"
            app:iconSize="24dp"
            app:iconTint="@color/cafe_marron" />

    </LinearLayout>

</LinearLayout>